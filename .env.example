ENV=development
LOG_LEVEL=INFO

SECRET_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local Postgres:
#   DATABASE_URL=postgresql+asyncpg://simulafly:simulafly@localhost:5432/simulafly
# Neon (use the pooler URL, convert sslmode=require -> ssl=require, drop channel_binding):
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://simulafly:simulafly@localhost:5432/simulafly

AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_IMAGE_EDIT_DEPLOYMENT=gpt-image-1
AZURE_IMAGE_GEN_DEPLOYMENT=

ALLOWED_ORIGINS=*

# Required for verification and password-reset emails.
# Gmail / Google Workspace requires an app password for this exact mailbox.
# Use 587 for STARTTLS or 465 for implicit TLS. Never use a normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@simulafly.com
SMTP_PASSWORD=
# Optional authorized sender address; defaults to SMTP_USER.
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=15

# CSV of accepted Google OAuth client IDs (`aud` of the ID token).
# Include the Android OAuth client ID AND the Web OAuth client ID
# (the Flutter client uses the Web one as `serverClientId`).
GOOGLE_CLIENT_IDS=

RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
IMAGE_GEN_RATE_LIMIT_PER_HOUR=10
UPLOAD_RATE_LIMIT_PER_HOUR=30

MAX_IMAGE_BYTES=5242880
MAX_REQUEST_BYTES=8388608

# Shared secret for /styles admin endpoints (POST/PATCH/DELETE).
# Empty = admin endpoints disabled. Generate with `openssl rand -hex 32`.
ADMIN_API_KEY=

# First-run bootstrap of a Super Admin account (so admin-panel login works on a
# fresh deploy). Both EMAIL and PASSWORD must be set to enable it; if either is
# empty the bootstrap is skipped. Safe to leave set across restarts — an
# existing account with this email is never modified (password is NOT reset).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Super Admin

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sandbox.co.in KYC/GST verification (use test credentials with the test URL)
SANDBOX_API_BASE_URL=https://test-api.sandbox.co.in
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_API_VERSION=1.0.0
KYC_RATE_LIMIT_PER_HOUR=10
